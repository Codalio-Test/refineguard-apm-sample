# Generated coverage reports
/server/coverage
/client/coverage

# Mutation-testing scratch space and results (see server/bin/mutation and
# client/stryker.config.json). Both are regenerated by the run scripts.
/server/.mutant
/client/.stryker-tmp
/client/reports

# OpenHands / Codalio orchestrator metadata — do not push
/.rhino-history
/.rhino-plan.md
/.rhino-review.md
/.openhands-state
/.codalio/usage.json
/.codalio/launch.json
/.codalio/source-repo
/.codalio/source-repo.json
/.codalio/prd-diff.json
/.codalio/prd-change.json
/.codalio/trade-project.json
/.codalio/ui-handoff.json
/.codalio/.rhino-plan.md.prev
/.codalio/paused-insufficient-credits
/.codalio/audit
/.env
/log/*
!/log/.keep
/tmp/*
!/tmp/.keep
/server/log/*
!/server/log/.keep
/server/tmp/*
!/server/tmp/.keep
/coverage/*
!/coverage/.keep
/server/coverage/*
!/server/coverage/.keep
